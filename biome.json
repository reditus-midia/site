{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": ["node_modules", "kit/**", "*.min.js"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
            "rules": { "recommended": true, "complexity": { "noForEach": "off", "useArrowFunction": "off" }, "style": { "useSingleVarDeclarator": "off", "useExponentiationOperator": "off" }, "suspicious": { "noShorthandPropertyOverrides": "off" } }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "css": {
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  }
}
